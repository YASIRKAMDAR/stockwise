# ---- Copy to .env and fill in. Never commit .env. ----
NODE_ENV=production
STOCKWISE_DOMAIN=stock.example.com
APP_BASE_URL=https://stock.example.com
# Used only by docker compose for the bundled Postgres container (generate: openssl rand -base64 32)
POSTGRES_PASSWORD=change-me
# Local development only (compose sets DATABASE_URL itself):
DATABASE_URL=postgresql://stockwise:change-me@localhost:5432/stockwise
# 32+ random chars (openssl rand -base64 48). Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
API_PORT=3000
TRUST_PROXY=true
SESSION_TTL_HOURS_PIN=12
SESSION_TTL_HOURS_PASSWORD=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_PER_MIN=10

# ---- Voice (server-side only; never exposed to the browser) ----
# gemini | fake (CI/dev, NOT speech recognition) | disabled (manual entry only)
VOICE_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
VOICE_MAX_SECONDS=25
VOICE_MAX_BYTES=3000000
VOICE_DAILY_LIMIT_USD=3
# Per-1M-token prices used for the cost meter. Fill from Google's official pricing page before go-live.
VOICE_PRICE_INPUT_PER_M_USD=0
VOICE_PRICE_OUTPUT_PER_M_USD=0
VOICE_PROPOSAL_TTL_MINUTES=10
# Raw audio is never stored. Setting this to true is rejected at startup.
VOICE_RETAIN_AUDIO=false

OWNER_POLL_INTERVAL_SECONDS=15
LOG_LEVEL=info

# ---- Off-site encrypted backups (S3-compatible: Cloudflare R2, Backblaze B2, AWS S3, …) ----
BACKUP_PASSPHRASE=change-me-store-this-somewhere-safe-offline
BACKUP_BUCKET=s3://your-bucket/stockwise
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
