    "@node-rs/argon2": "^2.0.0",
    "@stockwise/shared": "*",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
